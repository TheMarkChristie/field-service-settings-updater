    "dataverse",
    "dynamics-365",
    "power-platform",
    "field-service",
    "bookable-resource",
    "scheduling",
    "work-hours",
    "characteristics",
    "territory",
    "bulk-update"
  ],
  "contributors": [
    { "name": "Mark Christie", "url": "https://github.com/TheMarkChristie" }
  ],
  "homepage": "https://github.com/TheMarkChristie/field-service-settings-updater#readme",
  "repository": {
    "type": "git",
