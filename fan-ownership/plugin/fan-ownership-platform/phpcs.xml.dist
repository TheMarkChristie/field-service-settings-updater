<?xml version="1.0"?>
<ruleset name="FanOwnershipPlatform">
	<description>WordPress Coding Standards for the Fan Ownership Platform plugin.</description>

	<file>.</file>
	<!-- The test harness shims WordPress core functions by design. -->
	<exclude-pattern>tests/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!-- Full WordPress standard: Core + Docs + Extra. -->
	<rule ref="WordPress">
		<!-- Hook callbacks legitimately receive parameters they do not use. -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>

	<!-- The plugin's custom capability model (FO-102 permissions matrix). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="prx3_member"/>
				<element value="prx3_admin"/>
				<element value="prx3_edit_content"/>
				<element value="prx3_governance"/>
				<element value="prx3_moderate"/>
				<element value="prx3_board"/>
				<element value="prx3_view_tally"/>
				<element value="prx3_second_approve"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fan-ownership"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="prx3"/>
				<element value="PRX3"/>
			</property>
		</properties>
	</rule>
</ruleset>
