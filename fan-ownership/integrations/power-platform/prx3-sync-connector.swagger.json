{
  "swagger": "2.0",
  "info": {
    "title": "Fan Ownership Sync",
    "description": "Sync members, shares, and engagement between the fan ownership platform and Dataverse. Actions map to the plugin's prx3/v1 sync API.",
    "version": "1.0"
  },
  "host": "example.club",
  "basePath": "/wp-json/prx3/v1",
  "schemes": [ "https" ],
  "consumes": [ "application/json" ],
  "produces": [ "application/json" ],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Prx3-Api-Key"
    }
  },
  "security": [ { "api_key": [] } ],
  "paths": {
    "/sync/members": {
      "get": {
        "operationId": "GetMembers",
        "summary": "Get members (paged delta)",
        "description": "Members with ownership, agreement, and engagement data. Pass modified_since for a delta.",
        "parameters": [
          { "name": "modified_since", "in": "query", "type": "string", "description": "ISO 8601 timestamp or epoch seconds; only members touched since then." },
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "per_page", "in": "query", "type": "integer", "default": 100, "maximum": 200 }
        ],
        "responses": {
          "200": {
            "description": "Member page",
            "schema": {
              "type": "object",
              "properties": {
                "page": { "type": "integer" },
                "total": { "type": "integer" },
                "members": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Member" }
                }
              }
            }
          }
        }
      }
    },
    "/sync/register": {
      "get": {
        "operationId": "GetShareRegister",
        "summary": "Get share register events (append-only feed)",
        "description": "Register rows after since_id, oldest first, up to 500 per call.",
        "parameters": [
          { "name": "since_id", "in": "query", "type": "integer", "default": 0 }
        ],
        "responses": {
          "200": {
            "description": "Register rows",
            "schema": {
              "type": "object",
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "recorded_at": { "type": "string" },
                      "user_id": { "type": "integer" },
                      "event": { "type": "string" },
                      "shares": { "type": "integer" },
                      "holding_after": { "type": "integer" },
                      "source": { "type": "string" },
                      "consideration": { "type": "string" }
                    }
                  }
                },
                "last_id": { "type": "integer" },
                "more": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "/sync/upsert": {
      "post": {
        "operationId": "UpsertMember",
        "summary": "Upsert CRM enrichment onto a member",
        "description": "Matches by cross-reference ID, then email, then owner number. Ambiguous records return status=review and queue for a human. Only enrichment fields are writable.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [ "dataverse_id" ],
              "properties": {
                "dataverse_id": { "type": "string", "description": "Contact GUID" },
                "email": { "type": "string" },
                "owner_number": { "type": "integer" },
                "fields": {
                  "type": "object",
                  "description": "Enrichment fields: phone, mobile, address_line1, address_line2, city, postcode, country, marketing_email_optin, marketing_sms_optin, crm_notes"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "description": "linked or review" },
                "user_id": { "type": "integer" },
                "matched_by": { "type": "string", "description": "dataverse_id, email, or owner_number" },
                "reason": { "type": "string", "description": "When status=review: no_match, link_conflict, or duplicate_link" },
                "ignored": { "type": "array", "items": { "type": "string" }, "description": "Fields rejected by the ownership allow-list" }
              }
            }
          }
        }
      }
    },
    "/sync/review": {
      "get": {
        "operationId": "GetReviewQueue",
        "summary": "Get the matching review queue",
        "description": "Inbound records awaiting human resolution on the platform.",
        "responses": {
          "200": {
            "description": "Queue",
            "schema": {
              "type": "object",
              "properties": {
                "review": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Member": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "dataverse_id": { "type": "string" },
        "email": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "display_name": { "type": "string" },
        "owner_number": { "type": "integer" },
        "shares": { "type": "integer" },
        "is_owner": { "type": "boolean" },
        "agreement": {
          "type": "object",
          "properties": {
            "accepted_version": { "type": "string" },
            "current": { "type": "boolean" },
            "acceptances": { "type": "integer" }
          }
        },
        "badges": { "type": "array", "items": { "type": "string" } },
        "engagement": {
          "type": "object",
          "properties": {
            "ballots_voted": { "type": "integer" }
          }
        },
        "crm": { "type": "object" },
        "registered": { "type": "string" },
        "modified": { "type": "integer" }
      }
    }
  }
}
