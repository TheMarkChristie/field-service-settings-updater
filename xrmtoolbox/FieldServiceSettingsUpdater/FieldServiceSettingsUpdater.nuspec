<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MarkChristie.FieldServiceSettingsUpdater</id>
    <version>4.4.0-beta</version>
    <title>Field Service Resource Updater</title>
    <authors>Mark Christie</authors>
    <owners>Mark Christie</owners>
    <projectUrl>https://github.com/TheMarkChristie/field-service-settings-updater</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/TheMarkChristie/field-service-settings-updater/main/logo.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <description>Bulk-update Field Service Bookable Resource settings across many resources at once: Start/End Location, Organizational Unit, Display on Schedule Board, Enable for Availability Search, Hourly Rate and Time Off Approval; set work hours by weekly pattern or by copying another resource's calendar; and quick add/remove skills (characteristics) and territories for everyone selected. Preview every change before applying.</description>
    <summary>Bulk-edit Bookable Resource settings, work hours, skills and territories across many Field Service resources.</summary>
    <releaseNotes>4.4 Beta — Preserve existing all-day Time Off entries during Calendar Time Zone mismatch repair, including entries whose source-zone midnight is stored with a non-zero UTC offset.</releaseNotes>
    <tags>XrmToolBox Plugin Dataverse Dynamics365 FieldService BookableResource Scheduling WorkHours Characteristics Territory BulkUpdate</tags>
    <dependencies>
      <dependency id="XrmToolBox" version="1.2025.7.71" />
    </dependencies>
  </metadata>
  <files>
    <!-- Ship ONLY our own assembly + HTML; XrmToolBox provides WebView2 + the Dataverse SDK.
         The Tool Library extracts a "Plugins" folder into the user's XrmToolBox Plugins dir. -->
    <file src="bin\Release\net48\FieldServiceSettingsUpdater.dll" target="Plugins" />
    <file src="bin\Release\net48\app\field-service-settings-updater.html" target="Plugins\app" />
  </files>
</package>
